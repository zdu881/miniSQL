{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "CMake Configure",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": ["$gcc"],
            "detail": "Generated task by CMake."
        },
        {
            "type": "shell",
            "label": "Make Build",
            "command": "make",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": ["$gcc"],
            "detail": "Generated task for Make."
        },
        {
            "label": "CMake and Make",
            "dependsOn": [
                "CMake Configure",
                "Make Build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}